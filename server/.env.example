# Razorpay Test Mode credentials. Never use live keys in local/test environments.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Backend runtime and Firebase Admin SDK credentials.
PORT=8001
DB_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Required for email login. Use credentials from your SMTP provider.
# Also used for subscription receipts.
# Gmail defaults; override these for another SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults to SMTP_USER.
SMTP_FROM=
SUPPORT_EMAIL=

# Login verification and trusted-device settings.
# Optional dedicated OTP key; Firebase Admin's private key is used if unset.
LOGIN_OTP_SECRET=
LOGIN_OTP_MINUTES=10
LOGIN_SESSION_DAYS=10
TRUSTED_DEVICE_DAYS=10

# Optional local MaxMind GeoIP2/GeoLite2 City database (.mmdb). No external
# GeoIP service is used; city/state/location remain unavailable if unset.
GEOIP_DATABASE_PATH=

# Set only to the number of trusted reverse proxies in front of this server.
# Leave unset for direct connections.
TRUST_PROXY=

# Comment security settings.
COMMENT_EDIT_WINDOW_MINUTES=15
COMMENT_BLOCKED_WORDS=
COMMENT_BLOCKED_DOMAINS=
COMMENT_RECAPTCHA_SECRET_KEY=

# Google Cloud Translation API key (keep server-side; never expose in NEXT_PUBLIC_*).
GOOGLE_TRANSLATE_API_KEY=

# WebRTC ICE configuration. STUN discovers peer routes; it does not relay media.
# This public STUN service is only a default; use your own URL(s) if preferred.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# Optional self-hosted coturn. With use-auth-secret enabled, configure its
# static-auth-secret to the same value as WEBRTC_TURN_SHARED_SECRET.
# TURN URLs can be comma-separated, e.g. turn:turn.example.com:3478?transport=udp,
# turns:turn.example.com:5349?transport=tcp
WEBRTC_TURN_URLS=
WEBRTC_TURN_SHARED_SECRET=
